{
  "name": "vaultfill-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.mjs",
    "pack": "electron-packager . Vaultfill --platform=darwin --arch=arm64 --icon=icons/icon.icns --extend-info=build/Info.plist --out=dist --overwrite --ignore=^/test --ignore=^/dist --ignore=^/docs --ignore=^/scripts --ignore=^/build && node scripts/harden.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/notarize": "3.1.2",
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "electron": "45.1.0"
  }
}
